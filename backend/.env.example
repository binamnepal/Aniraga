DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Needed for /admin over https, e.g. https://api.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# Database. Leave empty for local SQLite, or use your Postgres connection string:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Where the Anivexa Node API is running (see ../api)
ANIVEXA_API_URL=http://localhost:4000

# Optional: shared cache. Leave empty to use in-process memory.
REDIS_URL=
